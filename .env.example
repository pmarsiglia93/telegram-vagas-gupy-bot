# =============================================================================
# JobMatch AI — variáveis de ambiente
# Copie para `.env` e preencha. NUNCA faça commit do .env (já está no .gitignore).
# =============================================================================

# --- Telegram (obrigatório) --------------------------------------------------
TELEGRAM_TOKEN=seu_token_do_botfather
CHAT_ID_GRUPO=seu_chat_id

# --- Coleta ------------------------------------------------------------------
# Idade máxima da vaga, em dias.
MAX_AGE_DAYS=3
# Teto de mensagens por execução (as melhores primeiro).
MAX_JOBS_PER_RUN=40

# --- Embeddings --------------------------------------------------------------
# hashing = local, sem chave, sem rede (padrão). É similaridade lexical, não
# semântica de verdade — bom o suficiente para o bot nunca depender de API.
# openai | gemini = similaridade semântica real (exige a chave correspondente).
EMBEDDING_PROVIDER=hashing
# Opcional. Padrões: openai=text-embedding-3-small, gemini=text-embedding-004
EMBEDDING_MODEL=

# --- Banco vetorial ----------------------------------------------------------
# memory = índice reconstruído a cada execução (padrão, ideal para CI).
# chroma = ChromaDB; exige `pip install chromadb`.
VECTOR_STORE=memory
# Diretório de persistência do Chroma. Vazio = efêmero.
CHROMA_PATH=

# --- LLM ---------------------------------------------------------------------
# none (padrão) | anthropic | openai | gemini
# Sem LLM o bot continua funcionando com o score heurístico + semântico.
LLM_PROVIDER=none

# Modelo. Vazio usa o padrão do provider:
#   anthropic -> claude-opus-5      (mais capaz; barato: claude-haiku-4-5)
#   openai    -> gpt-4o-mini
#   gemini    -> gemini-2.0-flash
LLM_MODEL=

# Controle de custo: no máximo N chamadas por execução, e só para vagas que já
# passaram deste score no pré-ranking.
LLM_MAX_JOBS=15
LLM_MIN_SCORE=45
LLM_TIMEOUT=60

# --- Chaves de API (só a do provider que você usar) --------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Caminhos ----------------------------------------------------------------
PROFILE_PATH=profile.yaml
DB_PATH=vagas_gupy.db

# --- Operação ----------------------------------------------------------------
# DRY_RUN=1 imprime as mensagens no terminal em vez de enviar ao Telegram.
DRY_RUN=
QUIET=
